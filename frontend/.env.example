# Local development — points to your locally running backend
# Copy this file to .env.local and fill in your values

# Public API URL (used by browser client-side code — shorten form, stats view)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Internal backend URL for server-side fetches (optional — defaults to NEXT_PUBLIC_API_URL)
# On Railway you can set this to the private/internal URL for faster inter-service calls
BACKEND_URL=http://127.0.0.1:8000
